{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imobiliarista.net/schemas/broker.schema.json",
  "title": "Broker",
  "description": "brokers/{brokerId}/profile-draft.json in R2 PRIVATE — §16, §29. Editable, authoritative source the publisher normalizes into broker-public.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brokerId", "userId", "slug", "status", "plan", "name", "updatedAt"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "brokerId": { "type": "string", "minLength": 1 },
    "userId": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["pending", "active", "suspended", "disabled"]
    },
    "plan": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "email": { "type": "string", "format": "email" },
    "creci": { "type": "string", "description": "Número completo do CRECI — não confundir com creciPublic (broker-public.schema.json)." },
    "phone": { "type": "string" },
    "whatsapp": { "type": "string" },
    "city": { "type": "string" },
    "about": { "type": "string" },
    "logo": { "type": ["string", "null"], "format": "uri" },
    "cover": { "type": ["string", "null"], "format": "uri" },
    "modules": {
      "type": "object",
      "additionalProperties": true
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
