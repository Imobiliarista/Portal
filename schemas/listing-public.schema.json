{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imobiliarista.net/schemas/listing-public.schema.json",
  "title": "ListingPublic",
  "description": "listings/{slug}.json — §15. Full public projection of a listing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationVersion",
    "slug",
    "status",
    "title",
    "description",
    "purpose",
    "type",
    "price",
    "location",
    "features",
    "gallery",
    "broker"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "publicationVersion": { "type": "integer", "minimum": 0 },
    "slug": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "suspended", "sold", "removed"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "purpose": { "type": "string", "enum": ["venda", "aluguel"] },
    "type": { "type": "string", "minLength": 1 },
    "price": { "type": "number", "minimum": 0 },
    "condominium": { "type": ["number", "null"], "minimum": 0 },
    "iptu": { "type": ["number", "null"], "minimum": 0 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "district"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "district": { "type": "string", "minLength": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bedrooms", "bathrooms", "parkingSpaces", "area"],
      "properties": {
        "bedrooms": { "type": "integer", "minimum": 0 },
        "bathrooms": { "type": "integer", "minimum": 0 },
        "parkingSpaces": { "type": "integer", "minimum": 0 },
        "area": { "type": "number", "minimum": 0 }
      }
    },
    "gallery": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "video": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string", "enum": ["youtube"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "tour360": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" }
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
