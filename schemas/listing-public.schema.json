{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imobiliarista.net/schemas/listing-public.schema.json",
  "title": "ListingPublic",
  "description": "listings/{slug}.json — §15. Full public projection of a listing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publicationVersion",
    "slug",
    "status",
    "title",
    "description",
    "purpose",
    "type",
    "price",
    "location",
    "features",
    "gallery",
    "broker"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "publicationVersion": { "type": "integer", "minimum": 0 },
    "slug": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "suspended", "sold", "removed"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "purpose": { "type": "string", "enum": ["venda", "aluguel"] },
    "type": { "type": "string", "minLength": 1 },
    "price": { "type": "number", "minimum": 0 },
    "condominium": { "type": ["number", "null"], "minimum": 0 },
    "iptu": { "type": ["number", "null"], "minimum": 0 },
    "yearBuilt": { "type": "integer", "minimum": 1800, "description": "VRSync YearBuilt. Teto de validação é ano atual + 5 (business/listings.js), não fixo aqui." },
    "municipalRegistrationCode": { "type": "string", "maxLength": 40, "description": "Inscrição municipal (IPTU) — sem correspondência no padrão VRSync, campo próprio do projeto." },
    "amenities": {
      "type": "array",
      "description": "Comodidades/proximidades (VRSync Features). Ver business/amenities.js para o rótulo pt-BR de cada id.",
      "items": {
        "type": "string",
        "enum": [
          "Pool", "Elevator", "Gym", "Sauna", "Playground", "Party Room", "Sports Court", "BBQ",
          "Gourmet Area", "Balcony", "Garden Area", "Backyard", "Fireplace", "Builtin Wardrobe",
          "Closet", "Furnished", "Cooling", "Heating", "Solar Energy", "Generator", "Intercom",
          "Electronic Gate", "Security Camera", "Security Guard on Duty", "Fenced Yard",
          "Home Office", "Coworking", "Pet Space", "Pets Allowed", "American Kitchen",
          "Gourmet Kitchen", "Laundry", "Edicule", "Deck",
          "Close to schools", "Close to hospitals", "Close to public transportation",
          "Close to shopping centers", "Close to main roads/avenues"
        ]
      },
      "uniqueItems": true
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "district"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "district": { "type": "string", "minLength": 1 },
        "street": { "type": "string", "maxLength": 200 },
        "streetNumber": { "type": "string", "maxLength": 20, "description": "Texto, não número — endereços reais aceitam \"s/n\", \"123A\" etc." },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "zipcode": { "type": "string", "description": "CEP (§46) — opcional; um anúncio sem CEP não entra no feed OLX (zipcode é obrigatório na spec da OLX), mas continua normal no portal/minisite." },
        "zone": {
          "type": "string",
          "enum": ["central", "norte", "sul", "leste", "oeste", "rural"],
          "description": "Região/zona da cidade (VRSync Location/Zone). Lista fixa global nesta primeira versão — não varia por cidade; ajustável no futuro se necessário."
        },
        "municipalZoning": { "type": "string", "maxLength": 20, "description": "Zoneamento urbano oficial da prefeitura (ex.: \"ZR3\", \"ZC1\") — DIFERENTE de \"zone\" (região Central/Norte/Sul/etc.), que é outro campo." }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bedrooms", "bathrooms", "parkingSpaces", "livingArea"],
      "properties": {
        "bedrooms": { "type": "integer", "minimum": 0 },
        "bathrooms": { "type": "integer", "minimum": 0 },
        "parkingSpaces": { "type": "integer", "minimum": 0 },
        "livingArea": { "type": "number", "minimum": 0, "description": "Área útil/construída, m² (VRSync LivingArea). Renomeado de \"area\"." },
        "lotArea": { "type": "number", "minimum": 0, "description": "Tamanho do terreno, m² (VRSync LotArea)." },
        "livingRooms": { "type": "integer", "minimum": 0, "description": "Número de salas — sem correspondência no padrão VRSync hoje (campo próprio do projeto); pode ganhar mapeamento pro feed se o padrão adicionar um elemento equivalente no futuro." },
        "kitchens": { "type": "integer", "minimum": 0, "description": "Número de cozinhas — sem correspondência no padrão VRSync hoje (campo próprio do projeto); mesma observação de livingRooms." },
        "suites": { "type": "integer", "minimum": 0, "description": "Número de suítes (VRSync Suites)." },
        "unitFloor": { "type": "integer", "minimum": 0, "description": "Andar da unidade (VRSync UnitFloor)." }
      }
    },
    "gallery": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "video": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string", "enum": ["youtube"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "tour360": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" }
      }
    },
    "broker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
