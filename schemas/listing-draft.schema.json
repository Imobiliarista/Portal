{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imobiliarista.net/schemas/listing-draft.schema.json",
  "title": "ListingDraft",
  "description": "listings/{listingId}/draft.json in R2 PRIVATE — §30, §31. Editable, authoritative source the publisher normalizes into listing-public.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "listingId",
    "brokerId",
    "city",
    "slug",
    "status",
    "title",
    "purpose",
    "type",
    "price",
    "features",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "listingId": { "type": "string", "minLength": 1 },
    "brokerId": { "type": "string", "minLength": 1 },
    "city": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "sold", "removed"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "purpose": { "type": "string", "enum": ["venda", "aluguel"] },
    "type": { "type": "string", "minLength": 1 },
    "price": { "type": "number", "minimum": 0 },
    "condominium": { "type": ["number", "null"], "minimum": 0 },
    "iptu": { "type": ["number", "null"], "minimum": 0 },
    "district": { "type": "string" },
    "zipcode": { "type": "string", "description": "CEP (§46, formatters/olx.js#zipcode) — opcional aqui (só o feed OLX exige), NNNNN-NNN ou NNNNNNNN." },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bedrooms", "bathrooms", "parkingSpaces", "area"],
      "properties": {
        "bedrooms": { "type": "integer", "minimum": 0 },
        "bathrooms": { "type": "integer", "minimum": 0 },
        "parkingSpaces": { "type": "integer", "minimum": 0 },
        "area": { "type": "number", "minimum": 0 }
      }
    },
    "gallery": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "video": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string", "enum": ["youtube"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "tour360": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
