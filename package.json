{
  "name": "portal-imobiliarista",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "npm run build:css",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./styles/input.css -o ./public/assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^9.39.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "globals": "^17.11.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.123.0"
  }
}
