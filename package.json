{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "imobiliarista.net — portal imobiliário + minisites de corretores (arquitetura JSON/R2)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "versions:upload": "wrangler versions upload",
    "deploy": "wrangler deploy",
    "test": "node --test tests/",
    "validate:schemas": "node scripts/validate-json.js",
    "validate:r2-cors": "node scripts/validate-r2-cors.js",
    "generate:cities": "node scripts/generate-cities-catalog.js",
    "generate:pwa": "node scripts/generate-pwa-assets.js",
    "generate:video-youtube": "node scripts/generate-video-youtube-assets.js",
    "generate:tour-360": "node scripts/generate-tour-360-assets.js",
    "generate:comparison": "node scripts/generate-comparison-assets.js",
    "generate:financing-calculator": "node scripts/generate-financing-calculator-assets.js",
    "generate:publications": "node scripts/generate-publications-assets.js",
    "generate:appointments": "node scripts/generate-appointments-assets.js",
    "generate:feeds": "node scripts/generate-feeds-assets.js",
    "generate:amenities": "node scripts/generate-amenities-assets.js",
    "rebuild:listing": "node scripts/rebuild-listing.js",
    "rebuild:broker": "node scripts/rebuild-broker.js",
    "rebuild:city": "node scripts/rebuild-city.js",
    "rebuild:all": "node scripts/rebuild-all.js",
    "rebuild:feeds": "node scripts/rebuild-feeds.js",
    "bootstrap:special-accounts": "node scripts/bootstrap-special-accounts.js",
    "r2-read-models:validate": "node scripts/r2-read-models.js validate",
    "r2-read-models:publish": "node scripts/r2-read-models.js publish"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
