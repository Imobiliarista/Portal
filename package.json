{
  "name": "portal-imobiliarista",
  "version": "1.0.0",
  "description": "Rede de portais imobiliários com minisites individuais para corretores",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:ts && npm run build:css",
    "build:ts": "esbuild src/index.ts --bundle --minify --platform=node --target=es2022 --outdir=dist --external:cloudflare",
    "build:css": "tailwindcss -i ./styles/input.css -o ./public/assets/css/tailwind.css --minify",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"public/**/*.{html,js,css}\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240605.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.32",
    "typescript": "^5.3.3",
    "wrangler": "^3.26.0"
  },
  "dependencies": {
    "pbkdf2": "^3.1.2"
  }
}
