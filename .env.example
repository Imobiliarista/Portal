# Modelo de variáveis de ambiente — copie para .dev.vars (Wrangler local)
# e configure os valores reais como Secrets em produção
# (`wrangler secret put NOME_DA_VARIAVEL`). Nunca commitar valores reais.

# Resend — envio de e-mails transacionais (confirmação de pré-cadastro,
# aprovação/reprovação, recuperação de senha). Ver project.md, seção 6.2.
RESEND_API_KEY=

# Cloudflare Turnstile — captcha do formulário público de pré-cadastro.
# Ver project.md, seção 6.1.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Asaas — infraestrutura da Fase 3 (src/services/asaas.ts,
# src/routes/webhooks/asaas.ts), isolada do fluxo real de cobrança dos
# planos. Ver project.md, seções 2.1, 2.3 e 3.
#
# ASAAS_ATIVO é a flag mestra do módulo: precisa ser exatamente "true"
# pra qualquer chamada real sair pra API do Asaas ou pro webhook
# processar algo além de logar o evento recebido. Default "false" — não
# é segredo, também vive em [vars] no wrangler.toml em produção.
ASAAS_ATIVO=false

# Chave da API sandbox do Asaas — sem efeito enquanto ASAAS_ATIVO=false.
ASAAS_SANDBOX_API_KEY=

# Token de validação do webhook do Asaas (header "asaas-access-token",
# configurado no cadastro do webhook no painel do Asaas). Sem ele, o
# endpoint de webhook rejeita toda requisição — nunca fica aberto sem
# autenticação.
ASAAS_WEBHOOK_TOKEN=

# Observação: a chave da API do Google Maps é opcional e por corretor
# (campo do próprio Plano no D1, seção 5.1) — não é uma variável global
# de ambiente.

# Alerta operacional — destinatário do e-mail disparado pelo consumer da
# dead letter queue (imob-queue-dlq) quando uma mensagem esgota as
# retentativas da imob-queue (Lote 23, src/queue-dlq.ts). Não é segredo;
# em produção também vive em [vars] no wrangler.toml.
EMAIL_ALERTA_OPERACIONAL=

# Feed Padrão da Rede — módulo Publicações (Lote 16, seção 4.19). Não é
# segredo (URL pública do Blogspot institucional); em produção também vive
# em [vars] no wrangler.toml, listado aqui só para referência do valor
# usado em dev local.
FEED_PADRAO_REDE_URL=
