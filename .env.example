# Cloudflare Workers
CF_ACCOUNT_ID=seu_account_id_cloudflare
CF_API_TOKEN=seu_api_token_cloudflare

# D1 Database
DB_ID=seu_database_id

# R2 Bucket
R2_BUCKET_NAME=imobiliarista-jsons
R2_ACCOUNT_ID=seu_account_id

# Cloudflare Queue
QUEUE_NAME=fila-geracao-lote

# Resend (Email Service)
RESEND_API_KEY=seu_resend_api_key

# Asaas (Payment - Sandbox mode)
ASAAS_API_KEY=sua_asaas_api_key
ASAAS_SANDBOX=true

# OpenAI/IA (Cloudflare Workers AI)
CF_AI_BINDING=AI

# Domínio
DOMINIO_RAIZ=imobiliarista.net

# Ambiente
AMBIENTE=desenvolvimento
